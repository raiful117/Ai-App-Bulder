PORT=8080
NODE_ENV=production
ALLOWED_ORIGINS=https://bcfbuilder.dev
DATABASE_URL=postgresql://bcf:change_me@localhost:5432/bcf_builder
REDIS_URL=redis://localhost:6379
BUILD_WORKER_SECRET=replace_with_32_char_secret
WORKSPACE_ROOT=/tmp/bcf_builds
ANDROID_SDK_ROOT=/opt/android-sdk
GRADLE_TIMEOUT_MS=300000

# Optional server-side AI providers (never bundled in Android client)
GEMINI_API_KEY=
OPENAI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
